{
  "info": {
    "name": "ShowRoom API",
    "description": "API del salone ShowRoom. Eseguire prima \"0. Login\". Le richieste con un codice fra parentesi nel nome verificano un rifiuto atteso (403, 404, 400, 409): il fallimento sarebbe una risposta riuscita.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Login",
      "description": "Da eseguire per prime: salvano il token in {{jwt}}, usato da tutte le altre richieste.",
      "item": [
        {
          "name": "Login SuperUser",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "login"
              ]
            },
            "description": "Salva il token in {{jwt}}: da qui in poi le richieste partono come SuperUser.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{superuserEmail}}\",\n  \"password\": \"{{superuserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"superuserPassword\")) {",
                  "    throw new Error(\"Variabile superuserPassword vuota: impostala nell'environment \\\"ShowRoom - Local\\\" (colonna Current value) e salva.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const store = (pm.environment.name ? pm.environment : pm.collectionVariables);",
                  "if (pm.response.code === 200) {",
                  "    store.set(\"jwt\", pm.response.json().token);",
                  "    store.set(\"loggatoCome\", \"SuperUser\");",
                  "} else {",
                  "    store.unset(\"jwt\");",
                  "}",
                  "pm.test(\"Login SuperUser riuscito (ora le richieste usano questo token)\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrazione utente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "register"
              ]
            },
            "description": "Il ruolo lo assegna il server: aggiungere \"ruolo\": \"Admin\" al corpo non cambia niente, perche RegisterRequest non ha quel campo.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"nome\": \"Mario\",\n  \"cognome\": \"Rossi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Utente creato (201) o gia esistente (409)\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Utente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "login"
              ]
            },
            "description": "Salva il token in {{jwt}}: da qui in poi le richieste partono come Utente.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"userPassword\")) {",
                  "    throw new Error(\"Variabile userPassword vuota: impostala nell'environment \\\"ShowRoom - Local\\\" (colonna Current value) e salva.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const store = (pm.environment.name ? pm.environment : pm.collectionVariables);",
                  "if (pm.response.code === 200) {",
                  "    store.set(\"jwt\", pm.response.json().token);",
                  "    store.set(\"loggatoCome\", \"Utente\");",
                  "} else {",
                  "    store.unset(\"jwt\");",
                  "}",
                  "pm.test(\"Login Utente riuscito (ora le richieste usano questo token)\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
