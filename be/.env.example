# Copia in .env e compila. .env NON va committato.
DB_URL=jdbc:postgresql://localhost:5432/showroom
DB_USERNAME=postgres
DB_PASSWORD=

# Almeno 32 caratteri casuali
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

SUPERUSER_EMAIL=superuser@showroom.it
SUPERUSER_PASSWORD=

# Gmail: password per le app (16 caratteri), non la password dell'account.
# Lasciare MAIL_USERNAME vuoto disattiva l'invio: gli avvisi restano da inviare.
MAIL_USERNAME=
MAIL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
